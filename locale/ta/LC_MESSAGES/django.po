#: accounts/admin.py:15
msgid "Not specified"
msgstr "குறிப்பிடப்படவில்லை"

#: accounts/admin.py:31
msgid "Person"
msgstr "தனிப்பட்ட விவரங்கள்"

#: accounts/admin.py:32
msgid "Faculty role"
msgstr "பீடப் பயனர் வகை"

#: accounts/admin.py:33
msgid "Access"
msgstr "அணுகல்"

#: accounts/admin.py:34
msgid "Dates"
msgstr "தேதிகள்"

#: accounts/admin.py:58 accounts/templates/admin/accounts/user/import.html:32
#: cases/forms.py:409 cases/forms.py:416
msgid "Name"
msgstr "பெயர்"

#: accounts/admin.py:87
msgid "Select a valid role."
msgstr "செல்லுபடியாகும் பங்கைத் தேர்ந்தெடுக்கவும்."

#: accounts/forms.py:9
msgid "Email or registration number"
msgstr "மின்னஞ்சல் அல்லது பதிவு எண்"

#: accounts/forms.py:14
msgid "Password"
msgstr "கடவுச்சொல்"

#: accounts/forms.py:21
msgid "That email, registration number or password is not right. Check them and try again."
msgstr "மின்னஞ்சல், பதிவு எண் அல்லது கடவுச்சொல் தவறானது. சரிபார்த்து மீண்டும் முயலவும்."

#: accounts/forms.py:24
msgid "This account has been deactivated. Contact the faculty office."
msgstr "இந்தக் கணக்கு முடக்கப்பட்டுள்ளது. பீட அலுவலகத்தைத் தொடர்புகொள்ளவும்."

#: accounts/forms.py:29
msgid "CSV file"
msgstr "CSV கோப்பு"

#: accounts/forms.py:29
msgid "Upload a UTF-8 CSV file, up to 5 MB and 10,000 accounts."
msgstr "அதிகபட்சம் 5 MB மற்றும் 10,000 கணக்குகள் கொண்ட UTF-8 CSV கோப்பைப் பதிவேற்றவும்."

#: accounts/importing.py:24
msgid "The CSV file must be no larger than 5 MB."
msgstr "CSV கோப்பு 5 MB ஐ மீறக்கூடாது."

#: accounts/importing.py:28
msgid "Save the file as UTF-8 CSV and upload it again."
msgstr "கோப்பை UTF-8 CSV ஆகச் சேமித்து மீண்டும் பதிவேற்றவும்."

#: accounts/importing.py:33
msgid "Use the template headers. Email and role columns are required; duplicate or unknown columns are not allowed."
msgstr "மாதிரியின் நெடுவரிசைத் தலைப்புகளைப் பயன்படுத்தவும். email மற்றும் role நெடுவரிசைகள் அவசியம். நகல் அல்லது அறியப்படாத நெடுவரிசைகள் அனுமதிக்கப்படாது."

#: accounts/importing.py:37
msgid "Every CSV row must have the same number of columns as the header."
msgstr "ஒவ்வொரு CSV வரியிலும் தலைப்பு வரியிலுள்ள அதே எண்ணிக்கையிலான நெடுவரிசைகள் இருக்க வேண்டும்."

#: accounts/importing.py:42
msgid "Import no more than 10,000 accounts at a time."
msgstr "ஒரு முறையில் 10,000 கணக்குகளுக்கு மேல் இறக்குமதி செய்ய வேண்டாம்."

#: accounts/importing.py:44
msgid "The CSV file has no account rows."
msgstr "CSV கோப்பில் கணக்கு வரிகள் இல்லை."

#: accounts/importing.py:47
msgid "The CSV file could not be read. Check its quoting and columns."
msgstr "CSV கோப்பைப் படிக்க முடியவில்லை. மேற்கோள் குறிகளையும் நெடுவரிசைகளையும் சரிபார்க்கவும்."

#: accounts/importing.py:67
msgid "Import between 1 and 10,000 accounts."
msgstr "1 முதல் 10,000 வரையிலான கணக்குகளை இறக்குமதி செய்யவும்."

#: accounts/importing.py:74
msgid "This import does not allow the selected role."
msgstr "இந்த இறக்குமதியில் தேர்ந்தெடுத்த பங்கு அனுமதிக்கப்படாது."

#: accounts/importing.py:77
msgid "An existing account has a different role. Change roles individually in user management."
msgstr "ஏற்கனவே உள்ள கணக்கிற்கு வேறு பங்கு உள்ளது. பயனர் நிர்வாகத்தில் பங்குகளைத் தனித்தனியாக மாற்றவும்."

#: accounts/importing.py:100
msgid "Select an existing authority for this account."
msgstr "இந்தக் கணக்கிற்கு ஏற்கனவே உள்ள பொறுப்பான பிரிவைத் தேர்ந்தெடுக்கவும்."

#: accounts/importing.py:102
msgid "Only authority accounts can have an authority."
msgstr "பொறுப்பான பிரிவின் கணக்குகளுக்கு மட்டுமே ஒரு பிரிவை ஒதுக்கலாம்."

#: accounts/importing.py:114
#, python-format
msgid "Duplicate value in the CSV column: %(column)s."
msgstr "CSV நெடுவரிசையில் நகல் மதிப்பு உள்ளது: %(column)s."

#: accounts/importing.py:119
#, python-format
msgid "This value already belongs to another account: %(column)s."
msgstr "இந்த மதிப்பு ஏற்கனவே மற்றொரு கணக்கிற்கு உரியது: %(column)s."

#: accounts/importing.py:122
#: cases/templates/cases/dashboards/authority_dashboard.html:28
msgid "Update"
msgstr "புதுப்பிக்கவும்"

#: accounts/importing.py:122
msgid "Create"
msgstr "உருவாக்கு"

#: accounts/importing.py:141
msgid "Accounts changed after the preview. Upload the CSV again to review the latest changes."
msgstr "முன்னோட்டத்திற்குப் பிறகு கணக்குகள் மாறியுள்ளன. சமீபத்திய மாற்றங்களைச் சரிபார்க்க CSV கோப்பை மீண்டும் பதிவேற்றவும்."

#: accounts/locale_support.py:10
msgid "This field is required."
msgstr "இந்தப் புலம் கட்டாயமானது."

#: accounts/locale_support.py:11
msgid "Enter a valid email address."
msgstr "சரியான மின்னஞ்சல் முகவரியை உள்ளிடவும்."

#: accounts/locale_support.py:12
msgid "Enter a valid date."
msgstr "சரியான தேதியை உள்ளிடவும்."

#: accounts/locale_support.py:13
msgid "Enter a valid value."
msgstr "சரியான பெறுமதியை உள்ளிடவும்."

#: accounts/locale_support.py:14
msgid "Enter a whole number."
msgstr "முழு எண்ணை உள்ளிடவும்."

#: accounts/locale_support.py:15
msgid "Select a valid choice. That choice is not one of the available choices."
msgstr "சரியான விருப்பத்தைத் தேர்ந்தெடுக்கவும். அந்த விருப்பம் பட்டியலில் இல்லை."

#: accounts/locale_support.py:16
msgid "Old password"
msgstr "தற்போதைய கடவுச்சொல்"

#: accounts/locale_support.py:17
msgid "New password"
msgstr "புதிய கடவுச்சொல்"

#: accounts/locale_support.py:18
msgid "New password confirmation"
msgstr "புதிய கடவுச்சொல்லை உறுதிப்படுத்தவும்"

#: accounts/locale_support.py:19
msgid "The two password fields didn’t match."
msgstr "இரு கடவுச்சொற்களும் பொருந்தவில்லை."

#: accounts/locale_support.py:20
msgid "Your old password was entered incorrectly. Please enter it again."
msgstr "தற்போதைய கடவுச்சொல் தவறானது. மீண்டும் உள்ளிடவும்."

#: accounts/locale_support.py:21
msgid "Your password can’t be entirely numeric."
msgstr "கடவுச்சொல் முழுவதும் எண்களாக இருக்கக் கூடாது."

#: accounts/locale_support.py:22
msgid "Your password can’t be a commonly used password."
msgstr "பொதுவாகப் பயன்படுத்தப்படும் கடவுச்சொல்லைப் பயன்படுத்த வேண்டாம்."

#: accounts/locale_support.py:23
msgid "Your password can’t be too similar to your other personal information."
msgstr "கடவுச்சொல் உங்கள் தனிப்பட்ட தகவல்களுக்கு மிக ஒத்ததாக இருக்கக் கூடாது."

#: accounts/locale_support.py:24
msgid "This password is too common."
msgstr "இந்தக் கடவுச்சொல் மிகவும் பொதுவானது."

#: accounts/locale_support.py:25
msgid "This password is entirely numeric."
msgstr "இந்தக் கடவுச்சொல்லில் எண்கள் மட்டுமே உள்ளன."

