#: accounts/models.py:18
msgid "Student"
msgstr "மாணவர்"

#: accounts/models.py:19
msgid "Lecturer"
msgstr "விரிவுரையாளர்"

#: accounts/models.py:20
msgid "Administrator"
msgstr "நிர்வாகி"

#: accounts/models.py:21
msgid "Relevant authority"
msgstr "பொறுப்பான பிரிவு"

#: accounts/models.py:22
msgid "Faculty management"
msgstr "பீட முகாமைத்துவம்"

#: accounts/models.py:23
msgid "System administrator"
msgstr "கணினி அமைப்பு நிர்வாகி"

#: accounts/models.py:32
msgid "Students sign in with this or their email."
msgstr "மாணவர்கள் இந்த எண் அல்லது மின்னஞ்சல் மூலம் உள்நுழையலாம்."

#: accounts/models.py:35 accounts/templates/admin/accounts/user/import.html:32
msgid "CPM number"
msgstr "CPM எண்"

#: accounts/models.py:36
msgid "Enter exactly five digits, for example 25678."
msgstr "சரியாக ஐந்து இலக்கங்களை உள்ளிடவும். எடுத்துக்காட்டு: 25678."

#: accounts/models.py:37
msgid "Required for students. Keep leading zeros."
msgstr "மாணவர்களுக்கு அவசியம். தொடக்கப் பூஜ்ஜியங்களை வைத்திருக்கவும்."

#: accounts/models.py:40 accounts/templates/admin/accounts/user/import.html:32
msgid "Lecturer ID"
msgstr "விரிவுரையாளர் அடையாள எண்"

#: accounts/models.py:41
msgid "Use letters, numbers, dots, hyphens, underscores or slashes."
msgstr "எழுத்துகள், எண்கள், புள்ளிகள், இணைப்புக்குறிகள், அடிக்கோடுகள் அல்லது சாய்வுக்கோடுகளைப் பயன்படுத்தவும்."

#: accounts/models.py:42
msgid "Required for lecturers. IDs are not case-sensitive."
msgstr "விரிவுரையாளர்களுக்கு அவசியம். பெரிய, சிறிய எழுத்து வேறுபாடு கருதப்படாது."

#: accounts/models.py:53
msgid "Only for relevant authority users: the unit whose cases they handle."
msgstr "அலுவலர் பொறுப்பேற்கும் பிரிவு."

#: accounts/models.py:67
msgid "A CPM number is required for a student."
msgstr "மாணவருக்கு CPM எண் அவசியம்."

#: accounts/models.py:69
msgid "A lecturer ID is required for a lecturer."
msgstr "விரிவுரையாளருக்கு விரிவுரையாளர் அடையாள எண் அவசியம்."

#: accounts/models.py:71
msgid "Only students can have a CPM number."
msgstr "மாணவர்களுக்கு மட்டுமே CPM எண் இருக்க முடியும்."

#: accounts/models.py:73
msgid "Only lecturers can have a lecturer ID."
msgstr "விரிவுரையாளர்களுக்கு மட்டுமே விரிவுரையாளர் அடையாள எண் இருக்க முடியும்."

#: accounts/templates/accounts/auth_base.html:7
#: accounts/templates/accounts/login.html:13
#: accounts/templates/accounts/password_reset_complete.html:7
