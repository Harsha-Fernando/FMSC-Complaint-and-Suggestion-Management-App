#: static/js/language.js:75
msgid "Could not change the language. Your entries are still here. Please try again."
msgstr "භාෂාව වෙනස් කළ නොහැකි විය. ඔබේ තොරතුරු තවමත් මෙහි ඇත. නැවත උත්සාහ කරන්න."

#: static/js/select.js:72
msgid "Choose an option"
msgstr "විකල්පයක් තෝරන්න"

#: static/js/upload.js:24
msgid "Files selected: %(count)s"
msgstr "තෝරාගත් ගොනු: %(count)s"

#: static/js/upload.js:24
msgid "No files chosen"
msgstr "ගොනු තෝරා නැත"

#: static/js/upload.js:34
msgid "%(size)s (too large, limit %(limit)s MB)"
msgstr "%(size)s (විශාල වැඩියි, උපරිම %(limit)s MB)"

#: static/js/upload.js:43
msgid "One or more files are larger than the limit."
msgstr "ගොනු එකක් හෝ කිහිපයක් සීමාව ඉක්මවා ඇත."

#: static/js/upload.js:89
msgid "Uploading %(progress)s (%(loaded)s of %(total)s)"
msgstr "උඩුගත වෙමින් %(progress)s (%(total)s න් %(loaded)s)"

#: static/js/upload.js:90
msgid "Upload finished. Saving the case…"
msgstr "උඩුගත කිරීම අවසන්. විමසුම සුරැකෙමින්…"

#: static/js/upload.js:107
msgid "The upload stopped. Check your connection and submit again."
msgstr "උඩුගත කිරීම නතර විය. සම්බන්ධතාව පරීක්ෂා කර නැවත යොමු කරන්න."

#: static/js/workspace.js:49
msgid "Notifications, %(count)s unread"
msgstr "දැනුම්දීම්, නොකියවූ %(count)s"

#: static/js/workspace.js:49
msgid "Notifications"
msgstr "දැනුම්දීම්"
