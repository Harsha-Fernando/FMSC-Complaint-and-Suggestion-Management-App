# Copy the values you need into your server's environment.
# The app reads environment variables; it does not load this file by itself.

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=cases.fmsc.example.lk
DJANGO_CSRF_TRUSTED_ORIGINS=https://cases.fmsc.example.lk
DJANGO_BEHIND_PROXY=1

DB_ENGINE=postgres
DB_NAME=fmsc_cms
DB_USER=fmsc_cms
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

MEDIA_ROOT=/srv/fmsc_cms/media
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=50
MAX_ATTACHMENTS_PER_UPLOAD=5

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.lk
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@fmsc.example.lk
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=FMSC Case Desk <no-reply@fmsc.example.lk>
SITE_URL=https://cases.fmsc.example.lk

REMINDER_AFTER_DAYS_NORMAL=3
REMINDER_AFTER_DAYS_URGENT=1
